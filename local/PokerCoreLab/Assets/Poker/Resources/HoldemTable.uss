.omc-root { flex-grow: 1; background-color: #101a21; color: #f1eddf; padding: 16px 32px; font-size: 17px; }
.omc-dealer-debug { flex-direction: row; align-items: center; flex-shrink: 0; padding: 5px 8px; background-color: #293e43; border-radius: 5px; margin-bottom: 5px; }
.omc-dealer-debug Label { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 13px; white-space: normal; }
.omc-dealer-debug-actions { flex-direction: row; flex-shrink: 0; justify-content: center; }
.omc-dealer-debug-actions Button { height: 30px; min-height: 30px; margin: 4px; font-size: 14px; }
.omc-multiplayer-dealer-debug { flex-direction: row; align-items: center; }
.omc-multiplayer-dealer-debug #omc-debug-source { min-width: 125px; max-width: 180px; height: 30px; min-height: 30px; margin: 4px; }
.omc-multiplayer-dealer-debug #omc-debug-source .unity-base-popup-field__input { background-color: #273d3e; color: #eee9d9; }
.omc-multiplayer-dealer-debug #omc-debug-source .unity-base-popup-field__text { height: 20px; min-height: 20px; margin: 0; padding: 0; align-self: center; white-space: nowrap; -unity-text-align: middle-left; }
.omc-multiplayer-dealer-debug .omc-dealer-debug-actions { flex-wrap: wrap; }
.dealer-debug-table .omc-header { height: 64px; }
.dealer-debug-table.compact .omc-header { height: 56px; }
.dealer-debug-table.without-amount .omc-controls { height: 84px; }
.dealer-debug-table.compact .omc-player .omc-card { height: 70px; width: 56px; }
.dealer-debug-table .omc-seat-info > Label, .dealer-debug-table .omc-hand-label, .dealer-debug-table .omc-pot, .dealer-debug-table .omc-last { padding-top: 0; padding-bottom: 0; margin-top: 1px; margin-bottom: 1px; }
.omc-header { flex-direction: row; align-items: center; justify-content: space-between; height: 54px; flex-shrink: 0; }
.omc-title { font-size: 28px; -unity-font-style: bold; }
.omc-subtitle { font-size: 12px; color: #91aba7; margin-top: 3px; }
.omc-header-right, .omc-stages, .omc-cards, .omc-seat, .omc-amounts, .omc-actions { flex-direction: row; align-items: center; justify-content: center; }
.omc-counter { color: #b2c1b9; font-size: 14px; margin-right: 16px; }
.omc-stages { height: 30px; flex-shrink: 0; margin-bottom: 5px; }
.omc-stage { color: #738e89; padding: 4px 18px; margin: 0 4px; border-bottom-width: 2px; border-bottom-color: #243b3c; font-size: 13px; }
.omc-stage.current { color: #f2d18d; border-bottom-color: #d6b773; }
.omc-stage.past { color: #b8c7b9; border-bottom-color: #507b69; }
.omc-table { flex-grow: 1; min-height: 410px; background-color: #183f38; border-width: 6px; border-color: #34564a; border-radius: 130px; margin: 6px 0 10px 0; padding: 12px 34px; align-items: center; justify-content: space-between; }
.omc-seat { flex-shrink: 0; }
.omc-seat-info { width: 170px; margin-right: 18px; }
.omc-seat-title { font-size: 18px; -unity-font-style: bold; }
.omc-stack { font-size: 24px; color: #eee7cf; margin-top: 3px; }
.omc-seat-status { font-size: 12px; color: #aec4b7; margin-top: 3px; }
.omc-seat-name.acting { color: #f4d28d; }
.omc-opponent .omc-card { width: 58px; height: 77px; }
.omc-player .omc-card { width: 84px; height: 105px; }
.omc-middle { align-items: center; flex-shrink: 0; }
.omc-pot { font-size: 26px; color: #efd197; -unity-font-style: bold; margin-bottom: 5px; }
.omc-pot-row { flex-direction: row; align-items: center; justify-content: center; }
.omc-pot-row Button { height: 27px; min-width: 70px; font-size: 12px; margin-left: 12px; padding: 2px 9px; }
.omc-board { height: 112px; }
.omc-card { width: 76px; height: 100px; margin: 0 6px; border-radius: 8px; padding: 6px 8px; background-color: #f3efdf; border-width: 2px; border-color: #d2d6c5; color: #1d3540; justify-content: space-between; align-items: center; flex-shrink: 0; }
.omc-card.red { color: #ad4642; }
.omc-card.best { border-color: #69b8d0; border-width: 3px; background-color: #e8f4f6; }
.omc-rank { font-size: 28px; -unity-font-style: bold; margin: 0; padding: 0; }
.omc-suit { font-size: 24px; margin: 0; padding: 0; }
.omc-opponent .omc-rank { font-size: 21px; }
.omc-opponent .omc-suit { font-size: 20px; }
.omc-card.hidden { background-color: #254852; border-color: #9a936c; justify-content: center; }
.omc-back { color: #d4bf86; font-size: 24px; }
.omc-card.empty { background-color: #1b463e; border-color: #3b6255; justify-content: center; }
.omc-placeholder { color: #6f9785; font-size: 12px; }
.omc-result { font-size: 18px; color: #f6d697; min-height: 23px; margin-top: 4px; }
.omc-last { font-size: 13px; color: #b1c7b9; min-height: 20px; white-space: normal; -unity-text-align: middle-center; max-width: 770px; }
.omc-hand-label { font-size: 12px; color: #c6d4bc; margin-top: 3px; -unity-text-align: middle-center; }
.omc-controls { height: 155px; flex-shrink: 0; align-items: center; }
.omc-root.complete .omc-controls { height: 110px; }
.omc-prompt { font-size: 18px; -unity-font-style: bold; min-height: 26px; margin: 3px 0; }
Button { height: 38px; min-width: 74px; padding: 4px 15px; margin: 3px; border-radius: 7px; border-width: 1px; border-color: #61726a; background-color: #273d3e; color: #eee9d9; font-size: 15px; }
Button:hover { background-color: #3c5752; border-color: #e5c782; }
Button:active { background-color: #657563; }
Button:disabled { opacity: 0.35; }
.omc-actions Button { min-width: 142px; height: 42px; font-size: 17px; }
.omc-primary { background-color: #d5b57c; border-color: #e4ca99; color: #152e30; -unity-font-style: bold; }
.omc-primary:hover { background-color: #f3d49d; }
.omc-quiet { background-color: #253037; color: #b3c0b8; }
.omc-amounts { height: 39px; flex-shrink: 0; }
.omc-amounts Button { height: 29px; min-width: 50px; font-size: 12px; padding: 3px 10px; }
.omc-caption, .omc-amount-hint { font-size: 12px; color: #9cb2a7; margin: 0 8px; }
.omc-amount-hint.invalid { color: #f0bb99; }
.omc-target { width: 100px; height: 30px; font-size: 17px; }
.omc-target .unity-text-element { color: #193b34; }
.omc-target > .unity-text-field__input { padding-top: 0; padding-bottom: 0; }
.omc-error { font-size: 12px; color: #f0bb99; min-height: 19px; }
.omc-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(10, 18, 23, 0.91); align-items: center; justify-content: center; }
.omc-help-card { width: 510px; padding: 24px; background-color: #1b3034; border-radius: 12px; border-width: 1px; border-color: #a3956d; }
.omc-help-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 16px; }
.omc-help-copy { white-space: normal; font-size: 16px; margin-bottom: 16px; }
.omc-help-tabs { flex-direction: row; margin-bottom: 12px; }
.omc-help-tabs Button { flex-grow: 1; padding-left: 8px; padding-right: 8px; }
.omc-help-scroll { max-height: 310px; margin-bottom: 10px; }
.omc-help-scroll .unity-scroll-view__content-container { flex-shrink: 1; }
.omc-option-description { white-space: normal; font-size: 14px; color: #b1c7b9; margin-bottom: 20px; }
.omc-reveal-option .unity-toggle__text { margin-left: 8px; color: #f1eddf; }
.omc-option-field { margin-bottom: 16px; min-height: 30px; font-size: 16px; }
.omc-option-field > .unity-base-field__label { min-width: 110px; color: #f1eddf; }
.omc-option-field .unity-base-popup-field__input { background-color: #273d3e; color: #eee9d9; }
.omc-root.compact { padding: 8px 18px; }
.compact .omc-header { height: 46px; }
.compact .omc-title { font-size: 24px; }
.compact .omc-stages { height: 25px; margin-bottom: 0; }
.compact .omc-table { min-height: 330px; border-width: 4px; border-radius: 90px; padding: 8px 24px; margin-bottom: 5px; }
.compact .omc-opponent .omc-card { width: 46px; height: 62px; }
.compact .omc-opponent .omc-rank { font-size: 17px; }
.compact .omc-opponent .omc-suit { font-size: 16px; }
.compact .omc-player .omc-card { width: 68px; height: 86px; }
.compact .omc-card { width: 62px; height: 80px; padding: 4px; margin: 0 5px; }
.compact .omc-rank { font-size: 23px; }
.compact .omc-suit { font-size: 20px; }
.compact .omc-board { height: 87px; }
.compact .omc-pot { font-size: 21px; margin-bottom: 2px; }
.compact .omc-result { font-size: 15px; min-height: 20px; margin-top: 1px; }
.compact .omc-last { font-size: 12px; min-height: 17px; }
.compact .omc-stack { font-size: 20px; }
.compact .omc-seat-title { font-size: 16px; }
.compact .omc-controls { height: 137px; }
.omc-root.complete.compact .omc-controls { height: 100px; }
.compact .omc-prompt { font-size: 16px; min-height: 23px; }
.compact .omc-actions Button { height: 38px; font-size: 15px; min-width: 126px; }
.compact .omc-help-card { padding: 20px; }
.compact .omc-help-scroll { max-height: 280px; }

.omc-opponents { flex-direction: row; justify-content: space-around; width: 100%; flex-shrink: 0; }
.multi-seat .omc-opponent { padding: 5px; border-width: 1px; border-color: rgba(90, 137, 110, 0.45); border-radius: 10px; margin: 0 4px; }
.multi-seat .omc-opponent .omc-seat-info { width: 118px; margin-right: 6px; }
.multi-seat .omc-opponent .omc-seat-title { font-size: 15px; white-space: normal; }
.multi-seat .omc-opponent .omc-stack { font-size: 20px; }
.multi-seat .omc-opponent .omc-card { width: 46px; height: 62px; margin: 0 3px; padding: 3px; }
.multi-seat .omc-opponent .omc-rank { font-size: 18px; }
.multi-seat .omc-opponent .omc-suit { font-size: 17px; }
.multi-seat .omc-opponent .omc-hand-label { font-size: 11px; }
.multi-seat .acting-seat { border-color: #f0ca7f; background-color: rgba(84, 106, 62, 0.36); }
.multi-seat .inactive-seat .omc-cards { opacity: 0.45; }
.multi-seat .omc-result, .multi-seat .omc-last { white-space: normal; -unity-text-align: middle-center; }
.multi-seat .omc-last { max-width: 770px; }
.multi-seat.compact .omc-opponent .omc-seat-info { width: 102px; margin-right: 3px; }
.multi-seat.compact .omc-opponent .omc-seat-title { font-size: 13px; }
.multi-seat.compact .omc-opponent .omc-stack { font-size: 18px; }
.multi-seat.compact .omc-opponent .omc-card { width: 38px; height: 54px; }
.multi-seat.compact .omc-opponent .omc-rank { font-size: 16px; }
.multi-seat.compact .omc-opponent .omc-suit { font-size: 15px; }
.multi-seat.compact .omc-opponent .omc-seat-status { font-size: 11px; }
.multi-seat .omc-player.acting-seat { background-color: transparent; }
.omc-root.pending .omc-controls { height: 110px; }
.omc-root.pending.compact .omc-controls { height: 100px; }

.with-utterance .omc-player .omc-seat-info { width: 130px; margin-right: 12px; }
.omc-utterance { width: 340px; margin-left: 22px; height: 78px; flex-shrink: 0; }
.compact .omc-utterance { margin-left: 12px; }
.omc-utterance-row { flex-direction: row; align-items: center; height: 36px; }
.omc-utterance-row > Label { font-size: 13px; color: #9cb2a7; margin-right: 8px; }
.omc-utterance-input { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; height: 30px; font-size: 15px; }
.omc-utterance-input .unity-text-element { color: #193b34; }
.omc-utterance-input > .unity-text-field__input { padding-top: 0; padding-bottom: 0; }
.omc-utterance-row Button { height: 30px; font-size: 13px; min-width: 76px; padding: 2px 8px; }
.omc-utterance-status { font-size: 12px; color: #b1c7b9; height: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.omc-utterance-scope { font-size: 11px; color: #9fb9bf; height: 16px; white-space: nowrap; }
.omc-hand-area .omc-compare { height: 19px; min-width: 0; font-size: 12px; padding: 0 4px; margin: 3px 0 0 0; border-width: 0; border-bottom-width: 1px; border-bottom-color: #819989; border-radius: 0; color: #c6d4bc; background-color: transparent; }
.omc-hand-area .omc-compare.selected { color: #9cd9e7; border-bottom-color: #9cd9e7; }
.omc-hand-area .omc-compare:hover { background-color: #34594b; }
.multi-seat .omc-opponent .omc-compare { font-size: 11px; }

/* The remote table shares its height with the connection bar. */
.remote-table .omc-table { padding-top: 8px; padding-bottom: 8px; }
.remote-table .omc-seat-info > Label { padding-top: 0; padding-bottom: 0; margin-top: 1px; margin-bottom: 1px; }
.remote-table .omc-seat-heading { flex-direction: row; align-items: center; width: 100%; }
.remote-table .omc-seat-heading > Label { padding: 0; margin-top: 1px; margin-bottom: 1px; }
.remote-table .omc-seat-heading .omc-seat-title { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.remote-table .omc-seat-position { flex-shrink: 0; margin-left: 3px; font-size: 11px; color: #c4d4c6; }
.remote-table .omc-seat-connection { flex-shrink: 0; margin-left: 3px; font-size: 10px; color: #f0d282; }
.remote-table.multi-seat.compact .omc-opponent .omc-seat-title { white-space: nowrap; font-size: 12px; }
.remote-table .omc-hand-label { padding-top: 0; padding-bottom: 0; margin-top: 2px; margin-bottom: 0; }
.remote-table .omc-pot { padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0; }
.remote-table .omc-last { padding-top: 0; padding-bottom: 0; margin-top: 1px; margin-bottom: 1px; }
.remote-table.without-amount .omc-controls { height: 110px; }
.remote-table.without-amount.compact .omc-controls { height: 100px; }
.remote-table.dealer-debug-table.without-amount.compact .omc-controls { height: 92px; }
.remote-table.dealer-debug-table.compact .omc-table { min-height: 345px; }
.remote-table .omc-stack.long-amount { font-size: 12px; white-space: normal; }
.remote-table.multi-seat .omc-opponent .omc-stack.long-amount { font-size: 12px; }
.remote-table .omc-seat-status { white-space: normal; }
.with-public-speech .omc-seat.with-public-utterance { flex-direction: column; align-items: stretch; width: 246px; max-width: 31%; min-width: 0; }
.with-public-speech.compact .omc-seat.with-public-utterance { width: 218px; }
.omc-seat-body { flex-direction: row; align-items: center; justify-content: center; }
.omc-public-utterance { height: 25px; min-width: 0; flex-shrink: 0; margin: 5px 0 0 0; padding: 2px 5px; font-size: 12px; color: #d6e3d9; background-color: #193a32; background-image: none; border-width: 1px; border-color: #48685a; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.omc-own-change { margin: 0; padding: 0 2px; height: 14px; flex-shrink: 0; }
.compact .omc-public-utterance { height: 20px; margin-top: 2px; padding-top: 0; padding-bottom: 0; font-size: 11px; }
.remote-table.with-public-speech.compact .omc-player .omc-card { height: 70px; width: 56px; }
.remote-table .omc-amount-hint { max-width: 250px; white-space: normal; padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0; }
.remote-table .omc-actions Button { max-width: 340px; white-space: normal; }
.remote-table .omc-actions Button.long-amount { font-size: 13px; height: 42px; padding-top: 2px; padding-bottom: 2px; }
